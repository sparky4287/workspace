import java.util.Random;

public class Alien extends GameObject {
	
	private int size, speed, direction, color, constant;
	
	Random randomInteger = new Random();
	
	public Alien() {
		size = 20+randomInteger.nextInt(50);
		direction = randomInteger.nextInt(359);
		constant = 1;
		speed = 5 * constant;
	}
	
	public int getSize() {
		return size;
	}
	public int getSpeed() {
		return speed;
	}
	public int getDirection() {
		return direction;
	}
	
	/*public void setSize(int newSize) {
