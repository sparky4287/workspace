package com.mycompany.a1;

public abstract class GameObject {
	private int size, location;
	
	public GameObject() {
		size = 0;
		/*location = (0,0)*/
	}
	
	public int getSize() {
		return size;
	}
	public int getLocation() {
		return location;
	}
	public void setSize(int newSize) {
		size = newSize;
	}
	public void setLocation(int newLocation) {
		location = newLocation;
	}
}
