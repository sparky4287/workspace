package com.mycompany.a1;

public class Astronaut extends GameObject {

	private int constant, health, speed;
	
	public Astronaut() {
		constant = 1;
		health = 5;
		speed = health * constant;
	}
	
	public int getHealth() {
		return health;
	}
	public int getSpeed() {
		return speed;
	}
	
	public void setHealth(int newHealth) {
		health = newHealth;
		speed = health * constant;
	}
}
